<!DOCTYPE html>
<html lang="zh-HK" class="dark h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>香港巴士 GPS 附近即時預報</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        kmb: '#e11d48',
                        ctb: '#eab308',
                        brandBg: '#090d16',
                        cardBg: '#111827',
                    }
                }
            }
        }
    </script>
    <style>
        input, select, button {
            font-size: 16px !important;
        }
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
        ::-webkit-scrollbar {
            width: 5px;
            height: 5px;
        }
        ::-webkit-scrollbar-track {
            background: #090d16;
        }
        ::-webkit-scrollbar-thumb {
            background: #1e293b;
            border-radius: 4px;
        }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 h-full h-[100dvh] flex flex-col font-sans antialiased overflow-hidden select-none">

    <div class="max-w-xl w-full mx-auto h-full flex flex-col p-3 sm:p-4 gap-3 justify-between">

        <!-- Header & Control Bar -->
        <header class="bg-slate-900/90 border border-slate-800/80 rounded-2xl p-3 shadow-xl flex flex-col gap-2.5 shrink-0 backdrop-blur-md">
            
            <div class="flex items-center justify-between gap-2">
                <div class="flex items-center gap-2.5">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-rose-600 via-indigo-600 to-amber-500 flex items-center justify-center text-white shadow-lg">
                        <i class="fa-solid fa-location-crosshairs text-lg animate-pulse"></i>
                    </div>
                    <div>
                        <h1 class="font-black text-base sm:text-lg text-slate-100 leading-tight">香港巴士 GPS 智能搜尋</h1>
                        <p class="text-xs text-slate-400 flex items-center gap-1.5 mt-0.5">
                            <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
                            九巴 KMB & 城巴 CTB 實時整合
                        </p>
                    </div>
                </div>

                <button onclick="triggerGpsSearch()" class="bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-black px-3.5 py-2 rounded-xl shadow-md flex items-center gap-2 transition active:scale-95 text-xs sm:text-sm">
                    <i class="fa-solid fa-rotate text-xs" id="gpsRefreshSpinner"></i>
                    <span>重新定位搜尋</span>
                </button>
            </div>

            <!-- Requirement 2 & 3 Control Filters -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-1 border-t border-slate-800/80">
                
                <!-- Distance Filter (300m, 500m, 1000m) -->
                <div class="flex items-center gap-1 bg-slate-950/80 border border-slate-800 p-1 rounded-xl">
                    <span class="text-[11px] text-slate-400 font-bold px-1.5 shrink-0">距離:</span>
                    <button onclick="setRadius(300)" id="radiusBtn300" class="radius-btn flex-1 bg-slate-800 text-slate-300 hover:bg-emerald-600 hover:text-white text-xs font-bold py-1.5 rounded-lg transition">300m</button>
                    <button onclick="setRadius(500)" id="radiusBtn500" class="radius-btn flex-1 bg-emerald-600 text-white text-xs font-bold py-1.5 rounded-lg transition">500m</button>
                    <button onclick="setRadius(1000)" id="radiusBtn1000" class="radius-btn flex-1 bg-slate-800 text-slate-300 hover:bg-emerald-600 hover:text-white text-xs font-bold py-1.5 rounded-lg transition">1000m</button>
                </div>

                <!-- Company Filter (全部 / 九巴 / 城巴) -->
                <div class="flex items-center gap-1 bg-slate-950/80 border border-slate-800 p-1 rounded-xl">
                    <span class="text-[11px] text-slate-400 font-bold px-1.5 shrink-0">公司:</span>
                    <button onclick="setCompanyFilter('all')" id="compBtnall" class="comp-btn flex-1 bg-indigo-600 text-white text-xs font-bold py-1.5 rounded-lg transition">全部</button>
                    <button onclick="setCompanyFilter('kmb')" id="compBtnkmb" class="comp-btn flex-1 bg-slate-800 text-slate-300 hover:bg-rose-600 hover:text-white text-xs font-bold py-1.5 rounded-lg transition">九巴</button>
                    <button onclick="setCompanyFilter('ctb')" id="compBtnctb" class="comp-btn flex-1 bg-slate-800 text-slate-300 hover:bg-amber-500 hover:text-slate-950 text-xs font-bold py-1.5 rounded-lg transition">城巴</button>
                </div>

            </div>
        </header>

        <main class="flex-1 bg-slate-900 border border-slate-800/80 rounded-2xl p-3.5 shadow-2xl flex flex-col overflow-hidden min-h-0">
            
            <div class="flex items-center justify-between border-b border-slate-800 pb-2.5 mb-2.5 shrink-0">
                <div class="flex items-center gap-2">
                    <i class="fa-solid fa-list-check text-indigo-400 text-base"></i>
                    <h2 id="resultHeaderTitle" class="text-sm sm:text-base font-black text-slate-200">附近巴士路線檢索結果 (上限 150 個)</h2>
                </div>
                <span id="resultCountBadge" class="bg-indigo-950 text-indigo-300 border border-indigo-500/30 text-xs font-black px-2.5 py-0.5 rounded-full">0 條路線</span>
            </div>

            <!-- Results Scrollable List Container -->
            <div id="resultsContainer" class="flex-1 flex flex-col gap-2.5 overflow-y-auto no-scrollbar py-1">
                <div class="text-center py-16 text-slate-500">
                    <i class="fa-solid fa-compass text-4xl mb-3 block text-slate-700 animate-spin"></i>
                    <p class="text-sm font-bold text-slate-300">正在獲取您的 GPS 位置並掃描附近站點...</p>
                    <p class="text-xs text-slate-500 mt-1">系統將自動整合九巴與城巴，並按距離由近至遠排列</p>
                </div>
            </div>

        </main>

        <!-- Footer status bar -->
        <footer class="bg-slate-900/80 border border-slate-800/80 rounded-xl px-3 py-2 text-center shrink-0">
            <p class="text-[11px] text-slate-400">
                ✨ 符合要求：自動去重同一方向最近路線、支援 300m/500m/1000m 半徑、上限 150 筆結果、實時即時預報 (ETA)
            </p>
        </footer>

    </div>

    <script>
        // Application State
        let currentRadius = 500;
        let currentCompanyFilter = 'all';
        let userLat = 22.3193; // Default Hong Kong Center
        let userLng = 114.1694;
        let rawCandidatesCache = [];
        let isSearching = false;

        // Caches for Open Data
        let kmbStopsCache = null;
        let kmbRouteStopsCache = null;
        let ctbStopsCache = null;
        let ctbRouteStopsCache = new Map();
        let kmbRouteListCache = null;
        let ctbRouteListCache = null;

        window.onload = async function() {
            await preloadBusMetadata();
            triggerGpsSearch();
        };

        // Preload route & stop metadata for fast matching
        async function preloadBusMetadata() {
            try {
                const [kmbR, ctbR] = await Promise.all([
                    fetch('https://rt.data.gov.hk/v1/transport/kmb/route/').then(r => r.json()).catch(() => null),
                    fetch('https://rt.data.gov.hk/v2/transport/citybus/route/ctb').then(r => r.json()).catch(() => null)
                ]);
                if (kmbR && kmbR.data) kmbRouteListCache = kmbR.data;
                if (ctbR && ctbR.data) ctbRouteListCache = ctbR.data;
            } catch (err) {
                console.warn('Metadata preload notice:', err);
            }
        }

        function setRadius(r) {
            currentRadius = r;
            document.querySelectorAll('.radius-btn').forEach(btn => {
                btn.className = 'radius-btn flex-1 bg-slate-800 text-slate-300 hover:bg-emerald-600 hover:text-white text-xs font-bold py-1.5 rounded-lg transition';
            });
            document.getElementById(`radiusBtn${r}`).className = 'radius-btn flex-1 bg-emerald-600 text-white text-xs font-bold py-1.5 rounded-lg transition';
            if (!isSearching) processAndRenderResults();
        }

        function setCompanyFilter(filter) {
            currentCompanyFilter = filter;
            document.querySelectorAll('.comp-btn').forEach(btn => {
                btn.className = 'comp-btn flex-1 bg-slate-800 text-slate-300 hover:bg-slate-700 text-xs font-bold py-1.5 rounded-lg transition';
            });
            const activeBtn = document.getElementById(`compBtn${filter}`);
            if (filter === 'all') activeBtn.className = 'comp-btn flex-1 bg-indigo-600 text-white text-xs font-bold py-1.5 rounded-lg transition';
            if (filter === 'kmb') activeBtn.className = 'comp-btn flex-1 bg-rose-600 text-white text-xs font-bold py-1.5 rounded-lg transition';
            if (filter === 'ctb') activeBtn.className = 'comp-btn flex-1 bg-amber-500 text-slate-950 text-xs font-bold py-1.5 rounded-lg transition';

            processAndRenderResults();
        }

        function calculateDistanceMeters(lat1, lon1, lat2, lon2) {
            const R = 6371000;
            const dLat = (lat2 - lat1) * Math.PI / 180;
            const dLon = (lon2 - lon1) * Math.PI / 180;
            const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
                      Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) * 
                      Math.sin(dLon/2) * Math.sin(dLon/2);
            const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
            return Math.round(R * c);
        }

        async function triggerGpsSearch() {
            if (isSearching) return;
            isSearching = true;

            const spinner = document.getElementById('gpsRefreshSpinner');
            spinner.classList.add('fa-spin');
            
            const container = document.getElementById('resultsContainer');
            container.innerHTML = `
                <div class="text-center py-16 text-slate-400">
                    <i class="fa-solid fa-location-dot text-4xl mb-3 block text-emerald-400 animate-bounce"></i>
                    <p class="text-sm font-bold text-slate-200">正在透過 GPS 獲取您的精確座標...</p>
                    <p class="text-xs text-slate-500 mt-1">請允許瀏覽器存取位置權限</p>
                </div>
            `;

            if (!("geolocation" in navigator)) {
                container.innerHTML = `<div class="text-center py-12 text-rose-400 text-xs"><p>您的瀏覽器不支援 GPS 定位功能</p></div>`;
                isSearching = false;
                spinner.classList.remove('fa-spin');
                return;
            }

            navigator.geolocation.getCurrentPosition(
                async (pos) => {
                    userLat = pos.coords.latitude;
                    userLng = pos.coords.longitude;
                    await fetchNearbyBusData(userLat, userLng);
                    isSearching = false;
                    spinner.classList.remove('fa-spin');
                },
                (err) => {
                    console.warn("GPS failed, falling back to default HK location (Central):", err);
                    userLat = 22.2819;
                    userLng = 114.1581;
                    fetchNearbyBusData(userLat, userLng);
                    isSearching = false;
                    spinner.classList.remove('fa-spin');
                },
                { timeout: 12000, enableHighAccuracy: true, maximumAge: 10000 }
            );
        }

        async function fetchNearbyBusData(lat, lng) {
            const container = document.getElementById('resultsContainer');
            container.innerHTML = `
                <div class="text-center py-16 text-slate-400">
                    <i class="fa-solid fa-spinner fa-spin text-4xl mb-3 block text-indigo-400"></i>
                    <p class="text-sm font-bold text-slate-200">正在掃描九巴與城巴 Open API 站點...</p>
                    <p class="text-xs text-slate-500 mt-1">正在進行距離計算與相同方向路線去重...</p>
                </div>
            `;

            try {
                // 1. Fetch KMB & CTB stops if not cached (Safely handling response objects and arrays)
                if (!kmbStopsCache) {
                    const res = await fetch('https://rt.data.gov.hk/v1/transport/kmb/stop').then(r => r.json()).catch(() => null);
                    if (res) kmbStopsCache = Array.isArray(res) ? res : (res.data || []);
                }
                if (!kmbRouteStopsCache) {
                    const res = await fetch('https://rt.data.gov.hk/v1/transport/kmb/route-stop').then(r => r.json()).catch(() => null);
                    if (res) kmbRouteStopsCache = Array.isArray(res) ? res : (res.data || []);
                }
                if (!ctbStopsCache) {
                    const res = await fetch('https://rt.data.gov.hk/v2/transport/citybus/stop/ctb').then(r => r.json()).catch(() => null);
                    if (res) ctbStopsCache = Array.isArray(res) ? res : (res.data || []);
                }

                const candidates = [];

                // Process KMB Nearby Stops
                if (Array.isArray(kmbStopsCache) && Array.isArray(kmbRouteStopsCache)) {
                    const nearbyKmbStops = new Map();
                    kmbStopsCache.forEach(s => {
                        const sLat = parseFloat(s.lat), sLng = parseFloat(s.long);
                        if (!isNaN(sLat) && !isNaN(sLng)) {
                            const dist = calculateDistanceMeters(lat, lng, sLat, sLng);
                            if (dist <= 1200) { // Fetch up to 1.2km to allow filtering later
                                nearbyKmbStops.set(s.stop, { stopId: s.stop, name: s.name_tc || s.name_en, distance: dist });
                            }
                        }
                    });

                    kmbRouteStopsCache.forEach(rs => {
                        if (nearbyKmbStops.has(rs.stop)) {
                            const stopInfo = nearbyKmbStops.get(rs.stop);
                            const boundVal = (rs.bound === 'O' || rs.bound === 'outbound') ? 'outbound' : 'inbound';
                            const routeObj = (kmbRouteListCache || []).find(r => String(r.route) === String(rs.route)) || {};
                            const dest = routeObj.dest_tc || routeObj.dest_en || '九龍/新界';

                            candidates.push({
                                company: 'kmb',
                                route: rs.route,
                                bound: boundVal,
                                serviceType: rs.service_type || '1',
                                stopId: rs.stop,
                                stopName: stopInfo.name,
                                dest: dest,
                                distance: stopInfo.distance,
                                uniqueKey: `kmb_${rs.route}_${boundVal}_${dest}`
                            });
                        }
                    });
                }

                // Process Citybus Nearby Stops
                if (Array.isArray(ctbStopsCache) && Array.isArray(ctbRouteListCache)) {
                    const nearbyCtbStops = new Map();
                    ctbStopsCache.forEach(s => {
                        const sLat = parseFloat(s.lat), sLng = parseFloat(s.long);
                        if (!isNaN(sLat) && !isNaN(sLng)) {
                            const dist = calculateDistanceMeters(lat, lng, sLat, sLng);
                            if (dist <= 1200) {
                                nearbyCtbStops.set(s.stop, { stopId: s.stop, name: s.name_tc || s.name_en, distance: dist });
                            }
                        }
                    });

                    // Fetch route stops for CTB in batches
                    const batch = ctbRouteListCache.slice(0, 45); // Optimizing performance for top routes
                    await Promise.all(batch.map(async (r) => {
                        if (!ctbRouteStopsCache.has(r.route)) {
                            try {
                                const res = await fetch(`https://rt.data.gov.hk/v2/transport/citybus/route-stop/ctb/${r.route}`);
                                if (res.ok) {
                                    const json = await res.json();
                                    const list = Array.isArray(json) ? json : (json.data || []);
                                    ctbRouteStopsCache.set(r.route, list);
                                }
                            } catch(e){}
                        }
                        const list = ctbRouteStopsCache.get(r.route) || [];
                        if (Array.isArray(list)) {
                            list.forEach(st => {
                                if (nearbyCtbStops.has(st.stop)) {
                                    const stopInfo = nearbyCtbStops.get(st.stop);
                                    const isOutbound = st.dir === 'O';
                                    const boundVal = isOutbound ? 'outbound' : 'inbound';
                                    const dest = isOutbound ? (r.dest_tc || r.dest_en) : (r.orig_tc || r.orig_en);

                                    candidates.push({
                                        company: 'ctb',
                                        route: r.route,
                                        bound: boundVal,
                                        serviceType: '1',
                                        stopId: st.stop,
                                        stopName: stopInfo.name,
                                        dest: dest || '港島/市區',
                                        distance: stopInfo.distance,
                                        uniqueKey: `ctb_${r.route}_${boundVal}_${dest}`
                                    });
                                }
                            });
                        }
                    }));
                }

                rawCandidatesCache = candidates;
                processAndRenderResults();

            } catch (err) {
                console.error("Fetch nearby bus error:", err);
                container.innerHTML = `<div class="text-center py-12 text-rose-400 text-xs"><p>載入附近巴士資料發生錯誤，請重新整理</p></div>`;
            }
        }

        // Requirement 6 & 7: Deduplication for same-direction routes (keep closest) and sort by distance
        function processAndRenderResults() {
            let filtered = rawCandidatesCache.filter(item => item.distance <= currentRadius);

            if (currentCompanyFilter !== 'all') {
                filtered = filtered.filter(item => item.company === currentCompanyFilter);
            }

            // Deduplication (Requirement 6): Same company, same route, same direction/destination -> keep closest distance
            const map = new Map();
            filtered.forEach(item => {
                const key = `${item.company}_${item.route}_${item.bound}_${item.dest}`;
                if (!map.has(key) || item.distance < map.get(key).distance) {
                    map.set(key, item);
                }
            });

            // Sort by distance from closest to furthest (Requirement 7)
            let finalResults = Array.from(map.values()).sort((a, b) => a.distance - b.distance);

            // Cap results to 150 items (Requirement 4)
            finalResults = finalResults.slice(0, 150);

            renderResultsList(finalResults);
        }

        function renderResultsList(results) {
            const container = document.getElementById('resultsContainer');
            const titleBadge = document.getElementById('resultCountBadge');
            titleBadge.innerText = `${results.length} 條路線`;

            if (results.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-16 text-slate-500">
                        <i class="fa-solid fa-bus-slash text-4xl mb-3 block text-slate-700"></i>
                        <p class="text-sm font-bold text-slate-300">在 ${currentRadius} 米範圍內未找到符合條件的路線</p>
                        <p class="text-xs text-slate-500 mt-1">請嘗試切換上方距離按鈕（例如改選 1000m）或切換公司</p>
                    </div>
                `;
                return;
            }

            container.innerHTML = results.map((item, idx) => {
                const compBadge = item.company === 'kmb'
                    ? '<span class="bg-rose-600 text-white text-[10px] font-black px-2 py-0.5 rounded shadow-sm">九巴 KMB</span>'
                    : '<span class="bg-amber-500 text-slate-950 text-[10px] font-black px-2 py-0.5 rounded shadow-sm">城巴 CTB</span>';

                const distText = item.distance < 1000 ? `${item.distance} 米` : `${(item.distance / 1000).toFixed(1)} 公里`;

                return `
                    <div class="bg-slate-950 border border-slate-800/80 hover:border-indigo-500/50 rounded-xl p-3 shadow-md flex items-center justify-between gap-3 transition">
                        <div class="flex items-center gap-3 overflow-hidden flex-1">
                            <div class="w-8 h-8 rounded-lg bg-slate-900 border border-slate-800 flex items-center justify-center text-slate-300 font-black text-xs shrink-0">
                                ${idx + 1}
                            </div>
                            <div class="overflow-hidden flex-1">
                                <div class="flex items-center gap-2">
                                    ${compBadge}
                                    <span class="text-base sm:text-lg font-black text-emerald-400">${item.route}</span>
                                    <span class="text-xs font-bold text-slate-200 truncate">往 ${item.dest}</span>
                                </div>
                                <div class="text-xs text-slate-400 truncate mt-1 flex items-center gap-1.5">
                                    <i class="fa-solid fa-location-dot text-[11px] text-indigo-400"></i>
                                    <span class="truncate">${item.stopName}</span>
                                </div>
                            </div>
                        </div>

                        <div class="text-right shrink-0 flex flex-col items-end gap-1">
                            <span class="bg-emerald-950/80 text-emerald-300 border border-emerald-500/30 text-xs font-black px-2.5 py-1 rounded-lg">
                                📍 ${distText}
                            </span>
                            <button onclick="fetchEtaForCard(this, '${item.company}', '${item.stopId}', '${item.route}', '${item.serviceType || '1'}', '${item.bound}')" class="text-[11px] text-indigo-400 hover:text-indigo-300 bg-indigo-950/60 border border-indigo-500/40 px-2 py-0.5 rounded-md transition flex items-center gap-1">
                                <i class="fa-regular fa-clock"></i> 查 ETA
                            </button>
                        </div>
                    </div>
                    <div id="eta-box-${item.company}-${item.stopId}-${item.route}" class="hidden bg-slate-900/90 border border-indigo-500/30 rounded-xl p-2.5 text-xs text-slate-200 -mt-1 mb-1">
                        <div class="flex items-center justify-between text-slate-400 pb-1 border-b border-slate-800 mb-1">
                            <span class="font-bold text-indigo-300"><i class="fa-solid fa-signal mr-1"></i> 實時到站預報</span>
                            <span class="animate-pulse text-[10px] text-emerald-400">更新中...</span>
                        </div>
                        <div class="eta-content-slot py-1 text-slate-300">正在取得實時到站資料...</div>
                    </div>
                `;
            }).join('');
        }

        async function fetchEtaForCard(btnEl, company, stopId, route, serviceType, bound) {
            const boxId = `eta-box-${company}-${stopId}-${route}`;
            const boxEl = document.getElementById(boxId);
            
            if (!boxEl.classList.contains('hidden')) {
                boxEl.classList.add('hidden');
                return;
            }
            
            boxEl.classList.remove('hidden');
            const contentSlot = boxEl.querySelector('.eta-content-slot');
            contentSlot.innerHTML = `<span class="text-slate-400"><i class="fa-solid fa-spinner fa-spin mr-1"></i> 正在查詢即時預報...</span>`;

            try {
                let etaRecords = [];
                if (company === 'kmb') {
                    const res = await fetch(`https://rt.data.gov.hk/v1/transport/kmb/eta/${stopId}/${route}/${serviceType}`).then(r => r.json()).catch(() => null);
                    if (res && res.data) etaRecords = res.data;
                } else {
                    const res = await fetch(`https://rt.data.gov.hk/v2/transport/citybus/eta/ctb/${stopId}/${route}`).then(r => r.json()).catch(() => null);
                    if (res && res.data) etaRecords = res.data;
                }

                const filtered = etaRecords.filter(item => {
                    if (!item.eta) return false;
                    const targetDir = bound === 'outbound' ? 'O' : 'I';
                    return item.dir === targetDir || item.dir === bound;
                });

                if (filtered.length === 0) {
                    contentSlot.innerHTML = `<span class="text-amber-400">暫無即時班次資料</span>`;
                    return;
                }

                const now = new Date();
                contentSlot.innerHTML = filtered.slice(0, 3).map((item, idx) => {
                    const etaTime = new Date(item.eta);
                    const diffMins = Math.max(0, Math.floor((etaTime - now) / 60000));
                    const timeStr = etaTime.toTimeString().substring(0, 5);
                    const rmk = item.rmk_tc || item.rmk_en || '';
                    return `
                        <div class="flex items-center justify-between py-0.5 border-b border-slate-800/60 last:border-0">
                            <span class="font-bold text-slate-100">${idx + 1}. 預計 ${timeStr} (${diffMins <= 0 ? '即將到達' : diffMins + ' 分鐘'})</span>
                            <span class="text-[10px] text-slate-400">${rmk}</span>
                        </div>
                    `;
                }).join('');

            } catch (err) {
                console.error("ETA fetch error:", err);
                contentSlot.innerHTML = `<span class="text-rose-400">無法獲取即時預報</span>`;
            }
        }
    </script>
</body>
</html>
